// Dependency updates (docs/development.md): one pull request a week with every minor and patch update, majors one
// by one, and the dependency dashboard as overview. The CI checks every pull request; merged by hand.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'group:allNonMajor'],
  timezone: 'Europe/Berlin',
  schedule: ['* 0-5 * * 1'],
  // Transitive npm packages only change with a lock file refresh.
  lockFileMaintenance: { enabled: true },
  // A new Go major version has a new module path: the imports are rewritten too.
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  packageRules: [
    {
      // The shadcn registry names its version (chart): `make ui-update` installs it.
      matchPackageNames: ['recharts'],
      enabled: false,
    },
    {
      // Modules of the go.mod tool lines are indirect requirements, which are skipped by default.
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchPackageNames: ['golang.org/x/tools', 'sigs.k8s.io/controller-tools'],
      enabled: true,
    },
  ],
  customManagers: [
    {
      // Linters run as `go run <module>/cmd/<tool>@<version>`.
      customType: 'regex',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: ['go run (?<depName>\\S+?)(?:/cmd/\\S+)?@(?<currentValue>v\\S+)'],
      datasourceTemplate: 'go',
    },
    {
      // The Alpine version outside the Dockerfile and the chart values: flag default, image build base, docs.
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/kubedactyl/README\\.md$/',
        '/^backend/main\\.go$/',
        '/^backend/internal/kube/attach_integration_test\\.go$/',
        '/^scripts/imagebuild/main\\.go$/',
        '/^docs/installation\\.md$/',
        '/^THIRD_PARTY_NOTICES\\.md$/',
      ],
      matchStrings: ['alpine:(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'alpine',
      datasourceTemplate: 'docker',
    },
  ],
}
